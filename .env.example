MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_LLM_MODEL=gemini-3.6-flash

# Which LLM answers questions: set groq here to use your Groq key (Gemini remains the code fallback).
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Optional least-privilege account used only by the question-answering path.
# Create it once as the privileged user (SELECT on the demo employee table only), e.g.:
#   CREATE USER 'sqlagent_ro'@'%' IDENTIFIED BY 'choose_a_strong_password';
#   GRANT SELECT ON your_database_name.RBAC_DEMO_EMPLOYEES TO 'sqlagent_ro'@'%';
# Leave both unset to keep using the account above for reads (previous behaviour).
MYSQL_READONLY_USER=
MYSQL_READONLY_PASSWORD=

# Local diagnostics verbosity: DEBUG, INFO (default), WARNING. DEBUG also attaches tracebacks.
SQL_AGENT_LOG_LEVEL=INFO

# Optional tracing: enable only for demo data after supplying a LangSmith key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sql-chatbot
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
SQL_WORKFLOW=classic

# Optional separate ColdChain source/checkpoints. Use a SELECT-only MySQL URL.
COLDCHAIN_DB_URL=
EVAL_DB_URL=
PG_URL=
COLDCHAIN_ADMIN_USERS=
# Used only when explicitly running scripts/setup_coldchain.py (not by the app):
COLDCHAIN_READONLY_PASSWORD=
